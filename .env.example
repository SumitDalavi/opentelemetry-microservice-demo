# ==============================================================================
# Progressive Credential Loading (PCL) Configuration
# Repository: opentelemetry-microservice-demo
# ==============================================================================
#
# TIER 1: ZERO-SETUP / LOCAL DEV / CI (Default)
# - In-memory OTLP trace and metric exporter.
#
# TIER 2 / TIER 3: LIVE OTEL COLLECTOR (Jaeger, Prometheus, Datadog)
# - Point collector endpoints to live telemetry backend.

OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
SERVICE_NAME=demo-service
PORT=8000
